#!/usr/bin/env bash
set -euo pipefail
set -x

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Usage: $0 <S3_ZARR_PATH|TILE_JSON_PATH> <INFERENCE_CHANNEL> [THRESHOLD_METHOD] [FIXED_THRESHOLD] [PERCENTILE]

Positional arguments:
  S3_ZARR_PATH|TILE_JSON_PATH  Input parent zarr path or tile JSON file.
  INFERENCE_CHANNEL            Inference channel: 488 or 561.
  THRESHOLD_METHOD             Thresholding method: fixed or percentile (default: fixed).
  FIXED_THRESHOLD              Fixed threshold value when method is 'fixed' (default: 1).
  PERCENTILE                   Percentile in [0, 100] when method is 'percentile', 50 = median (default: 50).
EOF
}

if [ "$#" -lt 2 ] || [ "$#" -gt 5 ]; then
  usage
  exit 1
fi

INPUT_PATH="$1"
INFERENCE_CHANNEL="$2"
# Thresholding config (optional positional args with defaults).
THRESHOLD_METHOD="${3:-fixed}"
FIXED_THRESHOLD="${4:-1}"
THRESHOLD_PERCENTILE="${5:-50}"

case "$THRESHOLD_METHOD" in
  fixed|percentile) ;;
  *)
    echo "Error: THRESHOLD_METHOD must be either 'fixed' or 'percentile', got '$THRESHOLD_METHOD'"
    exit 1
    ;;
esac
RAW_SAVE_DIR="/results/raw"
MASK_SAVE_DIR="/results/mask"
PRED_SAVE_DIR="/results/pred"
POSTPROCESSED_SAVE_DIR="/results/postprocessed"
DATA_PROCESS_JSON=""
S3_ZARR_PATH=""
TILE_JSON_PATH=""
RESOLUTION_SOURCE_ARGS=()
PREPROCESS_SOURCE_ARGS=()
DATA_PROCESS_SOURCE_ARGS=(--input-path "$INPUT_PATH")

case "$INFERENCE_CHANNEL" in
  488|561) ;;
  *)
    echo "Error: INFERENCE_CHANNEL must be either 488 or 561, got '$INFERENCE_CHANNEL'"
    exit 1
    ;;
esac

case "${INPUT_PATH,,}" in
  *.json)
    TILE_JSON_PATH="$INPUT_PATH"
    RESOLUTION_SOURCE_ARGS=(--tile-json "$TILE_JSON_PATH")
    PREPROCESS_SOURCE_ARGS=(--tile-json "$TILE_JSON_PATH")
    DATA_PROCESS_SOURCE_ARGS+=(--tile-json-path "$TILE_JSON_PATH")
    echo "Using tile JSON input: $TILE_JSON_PATH"
    ;;
  *)
    S3_ZARR_PATH="$INPUT_PATH"
    RESOLUTION_SOURCE_ARGS=(--zarr "$S3_ZARR_PATH")
    PREPROCESS_SOURCE_ARGS=(--zarr "$S3_ZARR_PATH")
    DATA_PROCESS_SOURCE_ARGS+=(--s3-zarr-path "$S3_ZARR_PATH")
    echo "Using parent zarr input: $S3_ZARR_PATH"
    ;;
esac

RES_488=""
RES_561=""
REFERENCE_TILE=""
while IFS='=' read -r key value; do
  case "$key" in
    RES_488) RES_488="$value" ;;
    RES_561) RES_561="$value" ;;
    REFERENCE_TILE) REFERENCE_TILE="$value" ;;
  esac
done < <(python3 "$SCRIPT_DIR/infer_channel_resolutions.py" "${RESOLUTION_SOURCE_ARGS[@]}")

if [ -z "$RES_488" ] || [ -z "$RES_561" ]; then
  echo "Error: failed to infer channel resolutions from '$INPUT_PATH'"
  exit 1
fi

if [ -z "$REFERENCE_TILE" ]; then
  echo "Error: failed to infer reference tile from '$INPUT_PATH'"
  exit 1
fi

DATA_PROCESS_JSON="/results/mask_data_process_${REFERENCE_TILE}_ch_${INFERENCE_CHANNEL}.json"
echo "Inferred resolutions from ${REFERENCE_TILE}: RES_488=${RES_488}, RES_561=${RES_561}"
echo "DataProcess metadata will be written to ${DATA_PROCESS_JSON}"

PROCESS_START_TIME="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

write_data_process_metadata() {
  local exit_code="$?"
  local run_status="success"
  local metadata_exit_code=0
  local process_end_time

  if [ "$exit_code" -ne 0 ]; then
    run_status="failed"
  fi

  process_end_time="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  set +e
  python3 "$SCRIPT_DIR/generate_data_process.py" \
    "${DATA_PROCESS_SOURCE_ARGS[@]}" \
    --res-488 "$RES_488" \
    --res-561 "$RES_561" \
    --inference-channel "$INFERENCE_CHANNEL" \
    --threshold-method "$THRESHOLD_METHOD" \
    --fixed-threshold "$FIXED_THRESHOLD" \
    --percentile "$THRESHOLD_PERCENTILE" \
    --start-date-time "$PROCESS_START_TIME" \
    --end-date-time "$process_end_time" \
    --run-status "$run_status" \
    --exit-code "$exit_code" \
    --output-json "$DATA_PROCESS_JSON"
  metadata_exit_code="$?"
  set -e

  if [ "$exit_code" -eq 0 ] && [ "$metadata_exit_code" -ne 0 ]; then
    exit "$metadata_exit_code"
  fi

  exit "$exit_code"
}
trap write_data_process_metadata EXIT

rm -rf "$PRED_SAVE_DIR" "$POSTPROCESSED_SAVE_DIR"
mkdir -p "$PRED_SAVE_DIR" "$POSTPROCESSED_SAVE_DIR"
touch "${POSTPROCESSED_SAVE_DIR}/${REFERENCE_TILE}_ch_${INFERENCE_CHANNEL}.txt"

# Step 1: Preprocess
python3 "$SCRIPT_DIR/inference_preprocess.py" \
 "${PREPROCESS_SOURCE_ARGS[@]}" \
 --channel 488 \
 --res "$RES_488" \
 --raw-save-dir "$RAW_SAVE_DIR/488" \
 --mask-save-dir "$MASK_SAVE_DIR/488" \
 --threshold-method "$THRESHOLD_METHOD" \
 --fixed-threshold "$FIXED_THRESHOLD" \
 --percentile "$THRESHOLD_PERCENTILE"

python3 "$SCRIPT_DIR/inference_preprocess.py" \
 "${PREPROCESS_SOURCE_ARGS[@]}" \
 --channel 561 \
 --res "$RES_561" \
 --raw-save-dir "$RAW_SAVE_DIR/561" \
 --mask-save-dir "$MASK_SAVE_DIR/561" \
 --threshold-method "$THRESHOLD_METHOD" \
 --fixed-threshold "$FIXED_THRESHOLD" \
 --percentile "$THRESHOLD_PERCENTILE"

# Step 2: Inference
python3 "$SCRIPT_DIR/inference.py" \
 --raw_tiff_path "${RAW_SAVE_DIR}/${INFERENCE_CHANNEL}" \
 --mask_tiff_path "${MASK_SAVE_DIR}/${INFERENCE_CHANNEL}" \
 --pred_save_dir "$PRED_SAVE_DIR"

# Step 3: Postprocess
python3 "$SCRIPT_DIR/postprocess_masks.py" \
 --input_path "$PRED_SAVE_DIR" \
 --output_dir "$POSTPROCESSED_SAVE_DIR" \
 --raw_base_dir "/results/raw" \
 --kernel_size 3 \
 --raw_intensity_percentile 75 \
 --summary_percentile 75
